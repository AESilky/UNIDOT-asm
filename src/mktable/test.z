OA8R|OCNEX	-		0x18	-	    ; nn
OAL3|OCSCC	OA8R|OCNEX	0x20	-	    ; {nz,z,nc},nn
OCC		OA8R|OCNEX	0x38	-	jr ; c,nn
OAL3|OCR8	OAR3|OCR8M	0x40	-	    ; {b,c,d,e,h,l,a},{b,c,d,e,h,l,(hl),a}
OCIHL		OAR3|OCR8	0x70	-	    ; (hl),{b,c,d,e,h,l,a}
OAL3|OCR8M	OA8|OCNEX	0x06	-	    ; {b,c,d,e,h,l,(hl),a},n
OCA		OA16|OCPEX	0x3a	-	    ; a,(nn)
OA16|OCPEX	OCA		0x32	-	    ; (nn),a
OCHL		OA16|OCPEX	0x2a	-	    ; hl,(nn)
OA16|OCPEX	OCHL		0x22	-	    ; (nn),hl
OAL3|OCSSDD	OA16|OCNEX	0x01	-	    ; {bc,de,hl,sp},nn
OAL3|OCSSDD	OA16|OCPEX	0x4b	FMED	    ; {bc,de,hl,sp},(nn)
OA16|OCPEX	OAL3|OCSSDD	0x43	FMED	    ; (nn),{bc,de,hl,sp}
