OCAFP		OCAF		0x08	-	ex ; af',af
-		-		0xd9	-	exx ;
-		-		0x76	-	halt ;
OAINT|OCNEX	-		0x46	FMED	im ; n
OCA		OA8|OCPEX	0xdb	-	    ; a,(n)
OAL3|OCR8	OCIC		0x40	FMED	in ; {b,c,d,e,h,l,a},(c)
OAL3|OCR8M	-		0x04	-	    ; {b,c,d,e,h,l,(hl),a}
OAL3|OCSSDD	-		0x03	-	inc ; {bc,de,hl,sp}
