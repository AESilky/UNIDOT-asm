; Test file for mktable and mkpdtab

#table O S
OCNULL			; no operand 
OCNEX			; nn (non-parenthesized expression)
OCPEX			; (nn) (parenthesized expression)
OCEXP			; {nn,(nn)} expression, parenthesized or not
OCR8			; {b,c,d,e,h,l,a}
OCA			; a
OCC			; c
OCSCC			; {nz,z,nc}
OCLCC			; {po,pe,p,m}
OCSSDD			; {bc,de,hl,sp}
OCQQ			; {bc,de,hl,af}
OCIC			; (c)
OCZR8			; {i,r}
OCAF			; af
OCAFP			; af'
OCHL			; hl
OCIHL			; (hl)
OCIBCDE			; {(bc),(de)}
OCSP			; sp
OCDE			; de
OCISP			; (sp)
OCR8M			; {b,c,d,e,h,l,(hl),a}

#table A S
#0,32
OANULL			; operand not used
OAL3			; left 3-bit field
OAR3			; right 3-bit field
OA8			; 8-bit field
OA16			; 16-bit field
OA8R			; 8-bit field, pc relative
OARST			; rst instruction address
OAINT			; interrupt mode

#table F S
#1,-1
FMCB			; insert 0xcb byte before opcode
FMED			; insert 0xed byte before opcode
FMNIXIY			; ix/iy not allowed
FMNDISP			; (ix+d)/(iy+d) not allowed
FMLAST			; final entry for this instruction


#table Z E E E E S S
OCA		OAR3|OCR8M	0x88	-	    ; a,{b,c,d,e,h,l,(hl),a}
OCA		OA8|OCNEX	0xce	-	    ; a,n
OCHL		OAL3|OCSSDD	0x4a	FMNIXIY|FMED	adc ; hl,{bc,de,hl,sp}
