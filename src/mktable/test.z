/************************************************************************
\*									*
\*			     UAS Assembler				*
\*									*
\*			uasz80.h - z80 specific header			*
\*									*
\************************************************************************/
/*
 * @(#)$Header: uasz80.z,v 1.2 87/12/01 13:30:23 rmm Rel $
 *
 * Declarations specific to uasz80
 */

/*
 * Parameters.
 */
\#define OPMAX	2		/* maximum number of instruction operands */


/*
 * Token types. (coordinated with grammar)
 */

\#define	TKR8	14		/* {b,d,e,h,l} */
\#define	TKZR8	15		/* {i,r} */
\#define	TKSCC	16		/* {nz,z,nc} */
\#define	TKA	17		/* a */
\#define	TKC	18		/* c */
\#define	TKHL	19		/* hl */
\#define	TKSP	20		/* sp */
\#define	TKBC	21		/* bc */
\#define	TKDE	22		/* de */
\#define	TKAF	23		/* af */
\#define	TKAFP	24		/* af' */
\#define	TKLCC	25		/* {po,pe,p,m} */
\#define	TKZR16	26		/* {ix,iy} */

/*
 * Structure declarations.
 */

struct	format {		/* instruction format table entry */
	char	fm_op[OPMAX];		/* operand descriptions */
	char	fm_skel;		/* opcode skeleton word */
	char	fm_flg;			/* flags */
};
/*
 * Global variable declarations.
 */
extern char		hlflg;		/* flag indicating reg hl was used */
extern char		ixiy;		/* prefix for ix/iy instruction, or 0 */
extern char		ixiyi;		/* flag indicating (ix+d) or (iy+d) */
extern uns		ixiyr;		/* (ix+d) or (iy+d) offset relocation */
extern long		ixiyv;		/* (ix+d) or (iy+d) offset value */

#output

/*
 * Operand classes.
 */

\#ifdef %s(OCNULL.0)
\#undef %s(OCNULL.0)
\#endif
\#ifdef %s(OCNEX.0)
\#undef %s(OCNEX.0)
\#endif
\#ifdef %s(OCPEX.0)
\#undef %s(OCPEX.0)
\#endif
\#ifdef %s(OCEXP.0)
\#undef %s(OCEXP.0)
\#endif

*O#define %s($0)	%d($0)
\#define OCMSK	0x1f		/* mask for operand class field in fm_op */

/*
 * Operand actions (in fm_op[]).
 */

*A#define %s($0)	%x($0)
\#define OAMSK	0xe0		/* mask for operand action field in fm_op */

/*
 * Instruction format table flags (in fm_flg).
 */

*F#define %s($0)	%x($0)

/*
 * Global variable declarations.
 */

#output uz80s.pd
*Z%h($0) %h($1) %h($2) %h(P($4)*FMLAST|$3) %s($4) %s($5)
#free

1	.end
2	.equ
3	.input
4	.byte
5	.word
6	.set
7	.block
8	.org
9	.clist
10	.sect
11	.space
12	.stitle
13	.title
14	.list
15	.else
16	.endif
17	.if
18	.global
19	.abs
20	.align
21	.within
22	.macro
23	.endm
24	.long
25	.eject
26	.common
28	.endr
29	.repeat
30	.error
31	.exit
33	.warn

0100h	$
0e00h	b	B
0e02h	d	D
0e03h	e	E
0e04h	h	H
0e05h	l	L
0f00h	i	I
0f01h	r	R
1000h	nz	NZ
1001h	z	Z
1002h	nc	NC
1100h	a	A
1200h	c	C
1300h	hl	HL
1400h	sp	SP
1500h	bc	BC
1600h	de	DE
1700h	af	AF
1904h	po	PO
1905h	pe	PE
1906h	p	P
1907h	m	M
1addh	ix	IX
1afdh	iy	IY

obj lst z80
