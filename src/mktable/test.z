OCA		OA8|OCNEX	0xc6	-	    ; a,n
OCHL		OAL3|OCSSDD	0x09	-	add ; hl,{bc,de,hl,sp}
OAR3|OCR8M	-		0xa0	-	    ; {b,c,d,e,h,l,(hl),a}
OA8|OCNEX	-		0xe6	-	and ; n
OAL3|OCNEX	OAR3|OCR8M	0x40	FMCB	bit ; n,{b,c,d,e,h,l,(hl),a}
OA16|OCNEX	-		0xcd	-	    ; nn
OAL3|OCLCC	OA16|OCNEX	0xc4	-	    ; {nz,z,nc,po,pe,p,m},nn
OCC		OA16|OCNEX	0xdc	-	call ; c,nn
-		-		0x3f	-	ccf ;
OAR3|OCR8M	-		0xb8	-	    ; {b,c,d,e,h,l,(hl),a}
OA8|OCNEX	-		0xfe	-	cp ; n
-		-		0xa9	FMED	cpd ;
-		-		0xb9	FMED	cpdr ;
-		-		0xa1	FMED	cpi ;
-		-		0xb1	FMED	cpir ;
-		-		0x2f	-	cpl ;
-		-		0x27	-	daa ;
OAL3|OCR8M	-		0x05	-	    ; {b,c,d,e,h,l,(hl),a}
OAL3|OCSSDD	-		0x0b	-	dec ; {bc,de,hl,sp}
-		-		0xf3	-	di ;
OA8R|OCNEX	-		0x10	-	djnz ; nn
-		-		0xfb	-	ei ;
OCDE		OCHL		0xeb	-	    ; de,hl
OCISP		OCHL		0xe3	-	    ; (sp),hl
