18                      18 ;/*     HL MUST CONTAIN THE STRING ADDRESS    */
19                      19 ;  PROCEDURE:  VIDSTRING  
20                      20 ;  PURPOSE IN LIFE:  OUTPUT NULL TERMINATED STRING TO SCREEN
21                      21 ;  GIVE IT: ADDRESS OF STRING IN HL
22                      22 ;  GET BACK: NOTHING
23                      23 ;  CHANGES DONE: HL, A, F
24                      24 
25  4300                25         .ORG 4300H
26  4300                26 VIDSTRING:
27  4300 cb3f           27         SRL     A       ; Debug
28  4302 7e             28         LD      A,(HL)          ; get the first character
29  4303 23             29         INC     HL
30  4304 fe00           30         CP      00H             ; check for 0 byte
31  4306 2805           31         JR      Z,VDONE         ; NO MORE LEFT QUIT
32  4308 cde702         32         CALL    VIDOUT          ; OUTPUT CHARACTER
33  430b 18f3           33         JR      VIDSTRING       ; continue
34  430d c9             34 VDONE:  RET
