 8                     356 ;
 9                     357 ;       INPUT X2 in B, Y2 in C, X1 in D, Y1 in E
10                     358 ;       Draw a vector from X1,Y1 to X2,Y2
11  4500               359         .ORG    4500H
12  4500               360 LINE:
13  4500 c5            361         PUSH    BC
14  4501 d5            362         PUSH    DE
15  4502 e5            363         PUSH    HL
16                     364 
17  4503 e600          365         AND     00H
18  4505 78            366         LD      A,B                     ; A = X2
19  4506 9a            367         SBC     A,D                     ; A = X2 - X1
20  4507 67            368         LD      H,A                     ; H = XDEL = X2 - X1
21                     369 
22  4508 3e01          370         LD      A,1
23  450a 32014a        371         LD      (XINC),A
24  450d 32004a        372         LD      (YINC),A
25                     373 
26  4510 e600          374         AND     00H
27  4512 79            375         LD      A,C                     ; A = X2
28  4513 9b            376         SBC     A,E                     ; A = X2 - X1
29  4514 6f            377         LD      L,A                     ; L = YDEL = Y2 - Y1
30                     378 
31  4515 cb7f          379         BIT     7,A                     ; CHECK SEE IF YDEL < 0
32  4517 2809          380         JR      Z,L1                    ; NEGATIVE CONTINUE
33  4519 3d            381         DEC     A                       ; SUBTRACT ONE
34  451a eeff          382         XOR     0FFH                    ; Take the Complement of A
35  451c 6f            383         LD      L,A
36  451d 3eff          384         LD      A,0FFH                  ; NEGATIVE ONE
37  451f 32004a        385         LD      (YINC),A
38                     386 
