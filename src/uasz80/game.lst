40  4523 cb7f          388         BIT     7,A                     ; CHECK SEE IF XDEL < 0
41  4525 2809          389         JR      Z,L2                    ; NEGATIVE CONTINUE
42  4527 3d            390         DEC     A                       ; SUBTRACT ONE
43  4528 eeff          391         XOR     0FFH                    ; Take the Complement of A
44  452a 67            392         LD      H,A
45  452b 3eff          393         LD      A,0FFH                  ; NEGATIVE ONE
46  452d 32014a        394         LD      (XINC),A
47  4530               395 L2:
