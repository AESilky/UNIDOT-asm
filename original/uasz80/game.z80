;						GROUP # 4
;					Lawrence M. McClure
;					Bruce Turner
;					David Hicks
;
;   TRS-80 "BASE ATTACK" video game
;   THE START OF THIS PROGRAM IS 43FD MAIN:

VIDOUT  .EQU    02E7H
INPUT   .EQU    0008H
PORT1A	.EQU	24H
PORT1B	.EQU	25H
PORT2A	.EQU	28H
PORT2B	.EQU	29H



;/*     HL MUST CONTAIN THE STRING ADDRESS    */
;  PROCEDURE:  VIDSTRING  
;  PURPOSE IN LIFE:  OUTPUT NULL TERMINATED STRING TO SCREEN
;  GIVE IT: ADDRESS OF STRING IN HL
;  GET BACK: NOTHING
;  CHANGES DONE: HL, A, F

	.ORG 4300H
VIDSTRING:
	SRL	A	; Debug
	LD	A,(HL)		; get the first character
	INC	HL
	CP	00H		; check for 0 byte
	JR	Z,VDONE		; NO MORE LEFT QUIT
	CALL	VIDOUT		; OUTPUT CHARACTER
	JR	VIDSTRING	; continue
VDONE:	RET
	
	
	
;/*---------------------------------------------*/
;/*	GCHAR(GET A CHARACTER FROM KEYBOARD)    */
;/*INPUT:NOTHING				*/
;/*OUTPUT:LOAD INTO A OF INPUT CHAR             */
;/*CHANGES: A					*/

;  PROCEDURE:  GCHAR  
;  PURPOSE IN LIFE: GET A CHARACTER FROM KEYBOARD 
;  GIVE IT: NOTHING
;  GET BACK: CHARACTER IN REGISTER A
;  CHANGES DONE: A, F

GCHAR:	
	CALL 	INPUT		;POLL UNTIL KEY INPUT

	JR	Z,GCHAR		;

	RET			;
	NOP
; POLL the keyboard for input return after delay if no input
POLL:	
	PUSH	BC
	LD	A,0FFH
PTOP:	CP	00H		; ARE WE DONE?
	JR	Z,PDONE
	DEC	A
	PUSH	AF
	CALL 	INPUT		;POLL UNTIL KEY INPUT
	JR	NZ,PEXIT	;
	POP	AF
	JR	PTOP

PDONE:	LD	A,0FFH		; NO KEY HIT
	NOP
	POP	BC
	RET
PEXIT:
	POP	BC
	POP	BC
	RET			;

	NOP
;	EXPLODE THE BASE STATION
EXPBASE:
	CALL	BASESET

	LD	HL,EXPBASE1	; BLOW UP BASE
	LD	(BASEADDR),HL
	CALL	DRAWBASE
	CALL	BASENOISE
	LD	HL,EXPBASE2	; BLOW UP BASE
	LD	(BASEADDR),HL
	CALL	DRAWBASE
	CALL	BASENOISE
	LD	HL,EXPBASE3	; BLOW UP BASE
	LD	(BASEADDR),HL
	CALL	DRAWBASE
	CALL	BASENOISE
	LD	HL,EXPBASE4	; BLOW UP BASE
	LD	(BASEADDR),HL
	CALL	DRAWBASE
	RET
;DRAW THE END BASE STATION
THEEND:
	LD	HL,TEND		; LOAD IN MESSAGE THE END
	LD	(BASEADDR),HL
	LD	HL,0C01H	; LOAD IN MESSAGE POSITION 
	LD	(BASEPOS),HL
	CALL	DRAWBASE
	RET

; SET UP THE SOUND GENERATOR CHIP 

SETUP:
	LD	A,0FH		; set up ports
	OUT	(26H),A
	OUT	(27H),A
	LD	A,4FH
	OUT	(2BH),A
	LD	A,00H
	OUT	(24H),A
CLEAR:
	LD	A,9FH	
	CALL	ENTER
	LD	A,0BFH
	CALL	ENTER
	LD	A,0DFH
	CALL	ENTER
	LD	A,0FFH
	CALL	ENTER
	RET

ENTER:
	PUSH	AF
	PUSH	BC
	OUT	(25H),A
	LD	A,01H
	OUT	(24H),A
	LD	B,020H
EW1:	
	DEC	B
	IN	A,(29H)
	BIT	0,A
	JR	NZ,ENDONE
	OR	B
	JR	NZ,EW1
ENDONE:
	LD	A,00H
	OUT	(24H),A
	POP	BC
	POP	AF
	RET

; DO THE EXPLOSION NOISE
	
EXPNOISE:
	EXX				; save all registers
	LD	D,A			; SAVE START OF LOOP
	LD	A,(EXPCT)		;
ELP1:	CP	00H
	JR	Z,EEXT
	DEC	A			; ONE DOWN
	PUSH	AF
	LD	A,D			; GET LOOP VALUE
	CP	00H			; ARE WE DONE?
	JR	NZ,ELP2
	POP	AF
	JR	EDONE
ELP2:	INC	D
	CALL	ENTER

	PUSH	AF
	LD	A,0FFH			; DO ABOUT 255 TIMES
ELP3:	CP	00H			; ARE WE DONE YET?
	JR	Z,ELP4
	DEC	A
	NOP
	NOP
	NOP
	NOP
	JR	ELP3

ELP4:
	POP	AF
	POP	AF
	JR	ELP1
EDONE:
	CALL	CLEAR
EEXT:
	LD	A,D
	EXX
	RET
;
; SET UP EXPLOSION FOR BASE STATION

BASESET:
	PUSH	BC
	PUSH	DE
	PUSH	HL
	CALL	EXPSET
	RET

; THE BASE EXPLOSION NOISE IS LOUDER AND LONGER SO DO IT
BASENOISE:
	LD	A,(EXPST)
	CALL	EXPNOISE			; CALL NOISE
	LD	(EXPST),A
	CALL	POLL
	RET



;/*-------------------------------------*/
;/* GLOBAL PROCEDURES                   */
;/* MAIN PROGRAM                        */
;/* INPUT : KEYBOARD DIGITS             */
;/* OUPUT : USER PROMPTS                */
;/*                                     */
;/* CHANGES : A, BC,                    */
;/*           DE, HL                    */
;/*           IY,                       */
;/*                                     */
;/*      SET UP SCREEN DISPLAY HEADINGS */
;/*-------------------------------------*/

;  PROCEDURE:  MAIN  
;  PURPOSE IN LIFE: GETS THE BALL ROLLING 
;  GIVE IT: NOTHING
;  GET BACK: EVERYTHING
;  CHANGES DONE: ALL


	.ORG	43FDH
MAIN:
	CALL SETUP
	LD	A,0CH		; string to clear screen
	CALL	VIDOUT		; output the string using vidout

	LD	HL,242BH		; Initialize all variables and
	LD	(BASEPOS),HL		; positions of ships and there
	LD	HL,BASE			; initial picture locations
	LD	(BASEADDR),HL

	LD	HL,STARTBOMB
	LD	(BOMBPOS),HL
	LD	HL,BOMB
	LD	(BOMBADDR),HL

	LD	HL,STARTSHIP
	LD	(SHIPPOS),HL
	LD	HL,SHIP
	LD	(SHIPADDR),HL
	
	LD	HL,242FH
	LD	(TURRPOS),HL
	LD	HL,TURRET
	LD	(TURRADDR),HL
	LD	A,04H
	LD	(TURRCNT),A

	LD	HL,PHASOR
	LD	(PHASORADDR),HL

	LD	A,00H
	LD	(EXPBOMBT),A			; DO NOT BLOW UP SHIP
	LD	(EXPSHIPT),A			; DO NOT BLOW UP BOMB
	LD	(ENABLBOMB),A			; DO NOT DRAW BOMB

	CALL	DRAWBASE

MLOOP:
	CALL	POLL		; get a number from the screen
	
	CP	39H		; IS IT A '9'
	JR	Z,MEXIT		; YES SO EXIT
	CP	0FFH		
	JR	Z,MNEXT		; CONTINUE IF WE DIDN't GET A CHARACTER

	CP	41H		; IS IT AN 'A'? YES THEN MOVE TURRET LEFT
	JR	NZ,MLOOP1
	CALL	TURRLEFT
	JR	MNEXT
MLOOP1:
	CP	47H		; IS IT AN 'G'? YES THEN MOVE TURRET RIGHT
	JR	NZ,MLOOP2
	CALL	TURRRIGHT
	JR	MNEXT
MLOOP2:
	CP	20H		; IS IT AN ' '? YES THEN FIRE PHASORS
	JR	NZ,MLOOP3
	CALL	FIREPHAS
	JR	MNEXT
MLOOP3:
MNEXT:
	LD	A,(EXPSHIPT)
	CP	00H
	JR	Z,MDOSHIP
	CALL	ESHIP			; EXPLODE SHIP
	JR	MNEXT1
MDOSHIP:
	CALL	DRAWSHIP
MNEXT1:
	LD	A,(EXPBOMBT)
	CP	00H
	JR	Z,MDOBOMB
	CALL	EBOMB			; EXPLODE BOMB
	JR	MLOOP
MDOBOMB:
	CALL	DRAWBOMB
	CP	0FFH
	JR	NZ,MLOOP
	CALL	EXPBASE			; EXPLODE BASE
	CALL	THEEND
	CALL	CHIME			; EITHER CALL LOCAL CHIME OR
	CALL	CLEAR			; THE FINAL CHIME DESCRIBED AT END
					; OF REPORT
MEXIT:	RST	18H		; EXIT

;
;	PHASOR NOISE ROUTINE DOES INCREMENTALLY MORE OF THE NOISE EVERY
;	TIME THAT IT IS CALLED

PNOISE:
	EX	AF,AF'
	EXX				; save all registers
	LD	A,(FLAG)		; ARE WE IN ERASE?
	CP	00H
	JR	NZ,PEXT			; 
	LD	A,(ZAP)			;
	BIT	4,A			; DONE YET?
	JR	NZ,PEXT
	LD	D,A
	INC	A
	LD	(ZAP),A
	LD	A,00H	
	LD	C,0C0H			; START NOISE
PLP1:	BIT	4,A			; ARE WE DONE?
	JR	NZ,PNDONE
	PUSH	AF
	ADD	A,C			; A = C0 to CF
	CALL	ENTER
	LD	A,D
	CALL	ENTER
	POP	AF
	INC	A
	JR	PLP1
PNDONE:
	LD	A,D
	ADD	A,0F0H			; FINAL
	CALL	ENTER
PEXT:
	EXX
	EX	AF,AF'
	RET




;
;	INPUT X2 in B, Y2 in C, X1 in D, Y1 in E
;	Draw a vector from X1,Y1 to X2,Y2
	.ORG	4500H
LINE:
	PUSH	BC
	PUSH	DE
	PUSH	HL

	AND	00H
	LD	A,B			; A = X2
	SBC	A,D			; A = X2 - X1
	LD	H,A			; H = XDEL = X2 - X1

	LD	A,1
	LD	(XINC),A
	LD	(YINC),A

	AND	00H
	LD	A,C			; A = X2
	SBC	A,E			; A = X2 - X1
	LD	L,A			; L = YDEL = Y2 - Y1

	BIT	7,A			; CHECK SEE IF YDEL < 0
	JR	Z,L1			; NEGATIVE CONTINUE
	DEC	A			; SUBTRACT ONE
	XOR	0FFH			; Take the Complement of A
	LD	L,A
	LD	A,0FFH			; NEGATIVE ONE
	LD	(YINC),A

L1:	LD	A,H			; A = XDEL
	BIT	7,A			; CHECK SEE IF XDEL < 0
	JR	Z,L2			; NEGATIVE CONTINUE
	DEC	A			; SUBTRACT ONE
	XOR	0FFH			; Take the Complement of A
	LD	H,A
	LD	A,0FFH			; NEGATIVE ONE
	LD	(XINC),A
L2:
	AND	00H
	LD	A,H
	SBC	A,L			; A = XDEL - YDEL
	BIT	7,A			; CHECK TO SEE IF NEGATIVE
	JR	NZ,LUND			; DOWN QUADRANT
					; ELSE UP QUADRANT
	LD	A,00H			; CLEAR OUT A
	LD	(XA),A			; XA = 0
	LD	A,H			; A = XDEL >> 1
	SRA	A			;
	LD	(YA),A			; YA = XDEL >> 1
LUP:
	LD	A,(YA)
	LD	C,A
	AND	00H
	LD	A,(XA)
	SBC	A,C			; A = XA - YA
	BIT	7,A			; IF(XA >= YA)then			
	JR	NZ,LU1			; ELSE JUMP
	LD	A,(YINC)
	ADD	A,E			; INCREMENT Y1 += yinc
	BIT	0,A			; CHECK TO SEE IF EVEN
	JR	NZ,LCNT
	CALL	PNOISE			; CALL PHASER NOISE
LCNT:
	LD	E,A
	LD	A,(YA)
	ADD	A,H			; YA += XDEL
	LD	(YA),A

LU1:	LD	A,(XA)
	ADD	A,L			; XA += YDEL
	LD	(XA),A
	LD	A,(XINC)
	ADD	A,D
	LD	D,A			; X1 += xinc
	LD	A,(FLAG)
	BIT	0,A			; CHECK SEE IF FLAG IS ON
	CALL	NZ,DOTOFF
	CALL	Z,DOT
	LD	A,D
	CP	B			; IF(X1 == X2) QUIT
	JR	Z,LEXT
	JR	LUP
	
LUND:
	LD	A,00H			; CLEAR OUT A
	LD	(YA),A			; YA = 0
	LD	A,L			; A = YDEL >> 1
	SRA	A			;
	LD	(XA),A			; YA = YDEL >> 1
LUNDT:
	LD	A,(XA)
	LD	B,A
	AND	00H
	LD	A,(YA)
	SBC	A,B			; A = YA - XA
	BIT	7,A			; IF(YA >= XA)then			
	JR	NZ,LUN1			; ELSE JUMP
	LD	A,(XINC)
	ADD	A,D			; INCREMENT X1 += xinc
	LD	D,A
	LD	A,(XA)
	ADD	A,L			; XA += YDEL
	LD	(XA),A

LUN1:	LD	A,(YA)
	ADD	A,H			; YA += XDEL
	LD	(YA),A
	LD	A,(YINC)
	ADD	A,E
	BIT	0,A			; CHECK TO SEE IF EVEN
	JR	NZ,LNCNT
	CALL	PNOISE			; CALL PHASER NOISE
LNCNT:
	LD	E,A			; Y1 += yinc
	LD	A,(FLAG)
	BIT	0,A			; CHECK SEE IF FLAG IS ON
	CALL	NZ,DOTOFF
	CALL	Z,DOT
	LD	A,E
	CP	C			; IF(Y1 == Y2) QUIT
	JR	NZ,LUNDT
	
LEXT:
	POP	HL
	POP	DE
	POP	BC
	RET
; *
; *    This is  a dot plotting routine for the 
; *    trs-80 minicomputer grapics screen.
; *
; *    Pass x, y coordinate in D, E pair
; *
	.ORG	4600H
DOT:
	PUSH	DE
	EXX				; save all registers
	POP	DE

	LD	IY, YDIV3		; intialize Y/ 3 table
	LD	A,E
	SLA	A
	LD	(OFF+2),a
	INC	A
	LD	(OFF2+2),a

OFF:	LD	L,(IY+0)		; load in HL = Y/3 * 64 + 3C00H
OFF2:	LD	H,(IY+0)		; 

	LD	C,D
	SRA	C			; BC = X/2
 	LD	B,00H
	ADD	HL,BC			; Add in the X PART;
					; HL now contains the screen byte to 
					; manipulate
	LD	IY, YMOD3		; intialize Y % 3 table
	LD	A,E
	LD	(OFF3+2),A
OFF3:	LD	B,(IY+0)		; load in B = Y%3 
	LD	A,D
	AND	01H			; A = X % 2
	ADD	A,B			; A now Contains the bit to SET
	SLA	A			; SHIFT LEFT  So that we can create
	SLA	A			; SHIFT LEFT  a SET instruction
	SLA	A			; SHIFT LEFT 
	LD	B,A			; SAVE A VALUE
	OR	0C6H			; Make a SET ?,A instruction
	LD	(SETB+1),A
	LD	A,B
	OR	046H			; Make a TST ?,A instruction
	LD	(TSTB+1),A
	BIT	7,(HL)
	JR	NZ,TSTB
	LD	(HL),80H
TSTB:	BIT	0,(HL)			; TEST BIT TO SET
	JR	Z,SETB			; NOT ALREADY SET SO SET IT
	EXX				; ***HIT FOUND
	POP	BC			; REMOVE RETURN ADDRESS
	JP	EXPLODE			; ***JUMP TO EXPLODE NOT LINE
	           			; *** GET READY FOR EXPLODE
	    
SETB:	SET	0,(HL)			; SET proper bit in screen byte
	EXX				; RESTORE VALUES
	RET				; RETURN

	.ORG	4660H
;
; THIS ROUTINE TURNS DOTS x,y OFF OTHERWISE IT IS THE SAME AS DOT
DOTOFF:
	PUSH	DE
	EXX				; save all registers
	POP	DE

	LD	IY, YDIV3		; intialize Y/ 3 table
	LD	A,E
	SLA	A
	LD	(OFFO+2),a
	INC	A
	LD	(OFF2O+2),a

OFFO:	LD	L,(IY+0)		; load in HL = Y/3 * 64 + 3C00H
OFF2O:	LD	H,(IY+0)		; 

	LD	C,D
	SRA	C			; BC = X/2
 	LD	B,00H
	ADD	HL,BC			; Add in the X PART;
					; HL now contains the screen byte to 
					; manipulate
	LD	IY, YMOD3		; intialize Y % 3 table
	LD	A,E
	LD	(OFF3O+2),A
OFF3O:	LD	B,(IY+0)		; load in B = Y%3 
	LD	A,D
	AND	01H			; A = X % 2
	ADD	A,B			; A now Contains the bit to SET
	SLA	A			; SHIFT LEFT  So that we can create
	SLA	A			; SHIFT LEFT  a SET instruction
	SLA	A			; SHIFT LEFT 
	OR	086H			; Make a SET ?,A instruction
	LD	(SETBO+1),A
	BIT	7,(HL)
	JR	NZ,SETBO
	LD	(HL),80H
SETBO:	RES	0,(HL)			; SET proper bit in screen byte
	EXX				; RESTORE VALUES
	RET				; RETURN
BLOWBAS:
	LD	A,03H			; INCREMENTS OF NOISE
	LD	(EXPCT),A
	LD	A,0F0H			; START OF LOOP OF NOISE
	LD	(EXPST),A
	CALL	CLEAR			; CLEAR OUT NOISE
	LD	A,0F4H			; SET UP BOMB NOISE
	CALL	ENTER

	LD	HL,EXPBASE1	; BLOW UP BASE
	LD	(BASEADDR),HL
	CALL	DRAWBASE
	CALL	BASENOISE
	CALL	POLL
	LD	HL,EXPBASE2	; BLOW UP BASE
	LD	(BASEADDR),HL
	CALL	DRAWBASE
	CALL	BASENOISE
	CALL	POLL
	LD	HL,EXPBASE3	; BLOW UP BASE
	LD	(BASEADDR),HL
	CALL	DRAWBASE
	CALL	BASENOISE
	CALL	POLL
	LD	HL,EXPBASE4	; BLOW UP BASE
	LD	(BASEADDR),HL
	CALL	DRAWBASE
	CALL	BASENOISE
	CALL	POLL
	LD	HL,EXPBASE4	; BLOW UP BASE
	LD	(BASEADDR),HL
	CALL	DRAWBASE
	CALL	BASENOISE
	CALL	POLL
	RET



	.ORG	4700H
;
;	GET THE ADDRESS OF THE SCREEN WHERE X,Y IS LOCATED	
;	D,E and RETURN IT IN HL
;
LOC:
	PUSH	AF
	PUSH	BC

	LD	IY, YDIV3		; intialize Y/ 3 table
	LD	A,E
	SLA	A
	LD	(LOFF+2),a
	INC	A
	LD	(LOFF2+2),a

LOFF:	LD	L,(IY+0)		; load in HL = Y/3 * 64 + 3C00H
LOFF2:	LD	H,(IY+0)		; 

	LD	C,D
	SRA	C			; BC = X/2
 	LD	B,00H
	ADD	HL,BC			; Add in the X PART;
					; HL now contains the screen byte to 
					; manipulate
	POP	BC
	POP	AF
	RET

	.ORG 4720H
;
; DRAW THE EXPLODING SHIPS PICTURES
ESHIP:
	LD	HL,(SHIPPOS)		; GET CURSOR POSITION
	LD	D,(HL)
	INC	HL
	LD	E,(HL)

	LD	HL,(SHIPADDR)
	LD	C,(HL)			; LOAD IN NUMBER CHARS /ROW
	INC	HL
	LD	B,(HL)			; LOAD IN # OF ROWS
	INC	HL

	CALL	DRAW
	LD	DE,0038H		; ADD THE EXPLOSION SHIP OFFSET
	ADD	HL,DE

	DEC	A			; DECREMENT # OF EXPLOSIONS
	LD	(EXPSHIPT),A		; SAVE A AGAIN
	CP	00H			; IS THIS THE LAST EXPLOSION?
	JR	NZ,ESH1
	LD	(ENABLSHIP),A		; DISABLE SHIP
	LD	HL,SHIP			; RESET ADDRESS
	JR	ESH2			; JUMP OVER NOISE
ESH1:	LD	A,(EXPST)		; START OF EXPLOSION
ESH2:	CALL	EXPNOISE		; EXPLOSION NOISE
	LD	(EXPST),A
	LD	(SHIPADDR),HL		; SAVE THIS ADDRESS
	RET

; DRAW THE EXPLODING BOMBS PICTURES

EBOMB:
	LD	HL,(BOMBPOS)		; GET CURSOR POSITION
	LD	D,(HL)
	INC	HL
	LD	E,(HL)

	LD	HL,(BOMBADDR)
	LD	C,(HL)			; LOAD IN NUMBER CHARS /ROW
	INC	HL
	LD	B,(HL)			; LOAD IN # OF ROWS
	INC	HL

	CALL	DRAW
	LD	DE,0012H		; ADD THE EXPLOSION BOMB OFFSET
	ADD	HL,DE

	DEC	A			; DECREMENT # OF EXPLOSIONS
	LD	(EXPBOMBT),A		; SAVE A AGAIN
	CP	00H			; IS THIS THE LAST EXPLOSION?
	JR	NZ,EBM1
	LD	HL,STARTBOMB
	LD	(BOMBPOS),HL		; RESET POSITION
	LD	HL,BOMB			; RESET ADDRESS
	LD	(ENABLBOMB),A		; DISABLE BOMB DRAWING
	JR	EBM2			; JUMP OVER NOISE
EBM1: 	LD	A,(EXPST)		; START OF EXPLOSION
EBM2:	CALL	EXPNOISE		; EXPLOSION NOISE
	LD	(EXPST),A
	
	LD	(BOMBADDR),HL		; SAVE THIS ADDRESS
	RET

	.ORG	4790H
; LOCAL CHIME ROUTINE THE CORRECT VERSION IS 
; CALLED IN RUNNING OF PROGRAM
CHIME:
	LD	A,8CH
	CALL	ENTER			; SET UP CHIME
	LD	A,05H
	CALL	ENTER			; SET UP CHIME
	LD	A,0AAH
	CALL	ENTER			; SET UP CHIME
	LD	A,05H
	CALL	ENTER			; SET UP CHIME
	LD	A,0BH			; 12 TIMES THROUGH
CLP1:
	PUSH	AF
	LD	D,91H
	LD	A,D
CLP2:
	CALL	ENTER
	ADD	A,20H
	CALL	ENTER

	PUSH	AF
	LD	A,40H			; DELAY 64 TIMES
CLP3:	CP	00H
	JR	Z,CLP4
	DEC	A
	JR	CLP3			; LOOP
CLP4: 	POP	AF			; DELAY 
	INC	D
	LD	A,D
	CP	0A0H			; ARE WE DONE?
	JR	NZ,CLP2			; NO SO GO DO AGAIN
	POP	AF
	DEC	A
	CP	00H
	JR	NZ,CLP1			; DO ANOTHER CHIME
	RET

	
	

	.ORG	4800H
;	DRAW ARRAY OUTPUTS TO THE SCREEN AN ARRAY OF BYTES AT A 
;	GIVEN X,Y POSITION
;	DE HOLD X,Y BC HOLD HEIGHT, WIDTH HL HOLDS ADDRESS
;
;		     C   
;	X,Y_________________________
;	   |  |  |  |  |  |  |  |  |
;	B  |__|__|__|__|__|__|__|__|
;	   |  |  |  |  |  |  |  |  |
;	   |__|__|__|__|__|__|__|__|
DRAW:
	PUSH	AF
	PUSH	BC
	PUSH	DE
	PUSH	HL
	PUSH	HL

	CALL	LOC			; LOCATE BYTE FOR X,Y COORDINATE
					; IT IS IN HL
	LD	D,H
	LD	E,L			; SET DE TO HOLD SCREEN POSITION
	POP	HL			; HL HOLDS THE MEMORY BUFFER ADDRESS
	LD	A,B			; HOW MANY TIMES TO LOOP?
	LD	B,00H			; CLEAR OUT B
DLOOP:
	CP	00H			; IS A = 0?
	JR	Z,DEXIT			; YES SO NO MORE TO DO
	DEC	A

	PUSH	DE			; SAVE SCREEN POSITION
	PUSH	BC

DLOOP1:	LDI				; LOAD MEMORY ONTO SCREEN
	JP	PE,DLOOP1		;

	POP	BC
	POP	DE			; RESTORE SCREEN ADDRESS AND COUNT

	PUSH	HL			; SAVE MEMORY ADDRESS
	LD	H,D
	LD	L,E		
	LD	DE,0040H		; 
	ADD	HL,DE			; ADD 64 TO DE
	LD	D,H
	LD	E,L
	POP	HL			; ADDED
	JR	DLOOP			; GO AND DO IT AGAIN

DEXIT:
	POP	HL
	POP	DE
	POP	BC
	POP	AF
	RET

	NOP
	NOP
	NOP
	NOP
; DRAW THE BASE STATION

DRAWBASE:
	LD	HL,BASEPOS		; GET CURSOR POSITION
	LD	D,(HL)
	INC	HL
	LD	E,(HL)

	LD	HL,(BASEADDR)
	LD	C,(HL)			; LOAD IN NUMBER CHARS /ROW
	INC	HL
	LD	B,(HL)			; LOAD IN # OF ROWS
	INC	HL

	CALL	DRAW
	RET

	.ORG	4850H
; DRAW THE SHIP IN THE SHIPPOS POSITION

DRAWSHIP:
	LD	HL,(SHIPPOS)		; GET CURSOR POSITION
	LD	D,(HL)
	LD	A,D
	CP	62H			; IS THE SHIP AT THE BEGINNING?
	JR	NZ,DRWS1
	LD	(ENABLBOMB),A		; SET THE BOMB ENABLE
	LD	(ENABLSHIP),A		; ENABLE SHIP
DRWS1:
	INC	HL
	LD	E,(HL)
	INC	HL
	LD	A,(HL)
	CP	00H			; ARE WE AT THE END?
	JR	NZ,SHIPSET
	LD	HL,STARTSHIP		; BEGINNING ADDRESS FOR SHIP
	LD	(SHIPPOS),HL
	LD	HL,ERASHIP
	JR	SHSET
	
SHIPSET:
	LD	(SHIPPOS),HL

	LD	HL,(SHIPADDR)
SHSET:	LD	C,(HL)			; LOAD IN NUMBER CHARS /ROW
	INC	HL
	LD	B,(HL)			; LOAD IN # OF ROWS
	INC	HL

	LD	A,(ENABLSHIP)
	CP	00H
	JR	Z,SEXIT
	CALL	DRAW
SEXIT:	RET

	.ORG	489BH

; DRAW THE BOMB IN THE BOMBPOS POSITION

DRAWBOMB:
	LD	A,(ENABLBOMB)
	CP	00H			; IS THE BOMB ENABLED?
	JR	Z,DEXT			; NO SO EXIT
	LD	HL,(BOMBPOS)		; GET CURSOR POSITION
	LD	D,(HL)
	INC	HL
	LD	E,(HL)
	INC	HL
	LD	A,(HL)
	CP	00H			; ARE WE AT THE END?
	JR	NZ,BOMBSET
	LD	HL,STARTBOMB		; BEGINNING ADDRESS FOR SHIP
	LD	(BOMBPOS),HL
	LD	HL,ERABOMB
	LD	(ENABLBOMB),A		; ZERO OUT BOMB ENABLE
	LD	A,0FFH			; BLOW UP BASE
	JR	BSET
BOMBSET:
	LD	(BOMBPOS),HL

	LD	HL,(BOMBADDR)
BSET:	LD	C,(HL)			; LOAD IN NUMBER CHARS /ROW
	INC	HL
	LD	B,(HL)			; LOAD IN # OF ROWS
	INC	HL

	CALL	DRAW
DEXT:	
	RET
	NOP
	NOP


	.ORG	48E1H
; DRAW THE TURRET OF THE BASE STATION
DRAWTURR:
	LD	HL,TURRPOS		; GET CURSOR POSITION
	LD	D,(HL)
	INC	HL
	LD	E,(HL)

	LD	HL,(TURRADDR)
	LD	C,(HL)			; LOAD IN NUMBER CHARS /ROW
	INC	HL
	LD	B,(HL)			; LOAD IN # OF ROWS
	INC	HL

	CALL	DRAW
	RET

	NOP
	NOP
	NOP
	NOP
	NOP
	NOP
	.ORG	4900H
;	THIS ROUTINE MOVES AND DRAWS TURRET TO THE RIGHT
TURRRIGHT:
	PUSH	AF
	PUSH	BC
	PUSH	DE
	PUSH	HL

	LD	A,(TURRCNT)		; CHECK TO SEE IF ALL THE WAY OVER
	CP	8H			;
	JR	Z,TEXIT			; YES SO EXIT
	INC	A
	LD	(TURRCNT),A		; NO SO UPDATE CNT
	LD	HL,(TURRADDR)		; GET THE CURRENT TURRET ADDRESS
	LD	DE,0012H		; ADD ON OFFSET TO RIGHT
	ADD	HL,DE
	LD	(TURRADDR),HL		; UPDATE
	LD	HL,(PHASORADDR)
	LD	DE,0004H
	ADD	HL,DE
	LD	(PHASORADDR),HL		; UPDATE PHASOR ADDRESS
	CALL	DRAWTURR		; OUTPUT NEW TURRET
TEXIT:
	POP	HL
	POP	DE
	POP	BC
	POP	AF
	RET

	NOP
	NOP
	NOP
	NOP
	NOP
	NOP
;	THIS ROUTINE MOVES AND DRAWS TURRET TO THE LEFT
TURRLEFT:
	PUSH	AF
	PUSH	BC
	PUSH	DE
	PUSH	HL

	LD	A,(TURRCNT)		; CHECK TO SEE IF ALL THE WAY OVER
	CP	00H			;
	JR	Z,TLEXIT		; YES SO EXIT
	DEC	A
	LD	(TURRCNT),A		; NO SO UPDATE CNT
	LD	HL,(TURRADDR)		; GET THE CURRENT TURRET ADDRESS
	LD	DE,0FFEEH		; SUB OFF OFFSET TO LEFT
	ADD	HL,DE
	LD	(TURRADDR),HL		; UPDATE
	LD	HL,(PHASORADDR)
	LD	DE,0FFFCH
	ADD	HL,DE
	LD	(PHASORADDR),HL		; UPDATE PHASOR ADDRESS
	CALL	DRAWTURR		; OUTPUT NEW TURRET
TLEXIT:
	POP	HL
	POP	DE
	POP	BC
	POP	AF
	RET

	.ORG	495CH
; FIRE THE PHASORS
FIREPHAS:
	CALL	CLEAR			; CLEAR OUT NOISES
	LD	A,0E7H
	CALL	ENTER
	LD	A,0FH
	CALL	ENTER
	LD	A,00H			; Initialize PHASOR
	LD	(ZAP),A
	LD	HL,(PHASORADDR)		; GET THE PHASOR COORDINATES
	LD	D,(HL)			; D = X1 
	INC	HL
	LD	E,(HL)			; E = Y1 
	INC	HL
	LD	B,(HL)			; B = X2 
	INC	HL
	LD	C,(HL)			; C = Y2 
	INC	HL
	LD	A,00H
	LD	(FLAG),A		; SET FOR DRAWING
	CALL	LINE			; OUTPUT PHASOR
	CALL	POLL
	LD	A,0FH			; CLEAR PHASOR
	LD	(ZAP),A
	LD	A,01H
	LD	(FLAG),A		; SET TO ERASE
	CALL	LINE
	CALL	CLEAR
	LD	A,00H
FEXIT:
	RET

	.ORG	4999H
; THIS ROUTINE IS JUMPED TO FROM DOT IF IT FINDS THAT SOMETHING WAS
; IN THE POSITION OF THE DOT ABOUT TO BE DRAWN, IT MEANS THAT SOMETHING
; SHOULD BE EXPLODED.
; THIS ROUTINE INITIALIZES EXPLOSTIONS AFTER DETERMINING WHAT EXPLODED
EXPLODE:
	LD	A,E			; CHECK TO SEE IF BOMB OR SHIP
	ADD	A,0EDH			; SUBTRACT 10 FROM E
	BIT	7,A			; IS THE RESULT NEGATIVE?
	JR	NZ,EXPSH		; YES SO BLOW UP SHIP
	LD	A,04H			; LOAD EXPBOMBT WITH # BOMB PICTURES
	LD	(EXPBOMBT),A
	LD	HL,EXPBMB1		; SET THE FIRST PICTURE
	LD	(BOMBADDR),HL
EXPSET:
	LD	A,05H			; INCREMENTS OF NOISE
	LD	(EXPCT),A
	LD	A,0F0H			; START OF LOOP OF NOISE
	LD	(EXPST),A
	JR	EXEXIT			; RETURN TO PHASOR
EXPSH:
	LD	A,04H			; LOAD EXPSHIPT WITH # SHIP PICTURES
	LD	(EXPSHIPT),A
	LD	HL,EXPSHP1		; SET THE FIRST PICTURE
	LD	(SHIPADDR),HL
	LD	A,05H			; INCREMENTS OF NOISE
	LD	(EXPCT),A
	LD	A,0F0H			; START OF LOOP OF NOISE
	LD	(EXPST),A

EXEXIT:
	CALL	CLEAR			; CLEAR OUT NOISE
	LD	A,0F4H			; SET UP BOMB NOISE
	CALL	ENTER
	POP	HL			; SAME AS RETURNING FROM LINE
	POP	DE
	POP	BC
	RET



	.ORG	4A00H

