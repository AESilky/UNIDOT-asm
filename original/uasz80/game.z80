FLAG:	.byte	0		; IS LINE ON OR OFF
ZAP:	.byte	0		; FAZOR STOP
EXPCT:	.byte	0		; EXPLOSION COUNT FOR # of 
				; explosion Loops / picture drawn
EXPST:	.byte	0		; Current loop variable in explosion loop

